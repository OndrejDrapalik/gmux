font-family = "JetBrains Mono"
font-size = 13
adjust-cell-height = 15%

theme = "light:TokyoNight Day,dark:TokyoNight"
palette = 2=#60D701
palette = 10=#60D701
background = #101117


background-opacity = 1
background-blur-radius = 40

background-image = /Users/drew/.config/ghostty/backgrounds/arrietty.png
background-image-fit = cover
background-image-opacity = 0.04

cursor-style-blink = true
window-padding-x = 10
window-padding-y = 10

window-padding-color = extend
window-padding-balance = true
macos-titlebar-style = tabs

selection-invert-fg-bg = true
# Audible + dock-bounce on BEL (Claude Code Stop hook → tmux bell passthrough)
bell-features = system, attention, title
keybind = super+f=write_screen_file:open
keybind = shift+enter=text:\n
# Unbind default Ghostty tab switching (super+digit_X=goto_tab)
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind

# Cmd+`/1 for tmux pane cycling (sends M-`/M-1)
keybind = super+grave_accent=text:\x1b\x60
keybind = alt+grave_accent=text:\x1b~
keybind = super+1=text:\x1b1

# Cmd+2/3 for tmux window navigation (sends M-2/M-3)
keybind = super+2=text:\x1b2
keybind = super+3=text:\x1b3

# Opt+Cmd+1/2 for tmux window reordering (sends M-!/M-@)
keybind = cmd+opt+1=text:\x1b!
keybind = cmd+opt+2=text:\x1b@

# Cmd+Shift+K: clear screen + history (sends M-K). H/J/L still send M-H/J/L
# for the prefix resize-cycle bindings.
keybind = super+shift+k=text:\x1bK
keybind = super+shift+h=text:\x1bH
keybind = super+shift+j=text:\x1bJ
keybind = super+shift+l=text:\x1bL

# Opt+Shift+HJKL: directional pane resize through thirds
# (sends shift+alt arrow CSIs so tmux sees S-M-Left/Down/Up/Right)
keybind = alt+shift+h=text:\x1b[1;4D
keybind = alt+shift+j=text:\x1b[1;4B
keybind = alt+shift+k=text:\x1b[1;4A
keybind = alt+shift+l=text:\x1b[1;4C

# Cmd+Opt+K: clear screen, history preserved (sends M-C)
keybind = cmd+opt+k=text:\x1bC

# Cmd+p for tmux recursive pane splitting (sends M-p)
keybind = cmd+p=text:\x1bp

# Cmd+Shift+p starts tmux recursive pane splitting top/bottom (sends M-P)
keybind = cmd+shift+p=text:\x1bP

# Cmd+hjkl for tmux directional pane navigation (sends M-h/M-j/M-k/M-l)
# super+h overrides macOS "Hide App" only while Ghostty is focused
keybind = super+h=text:\x1bh
keybind = super+j=text:\x1bj
keybind = super+k=text:\x1bk
keybind = super+l=text:\x1bl

# Opt+hjkl: swap-pane in direction. Sends ESC+ctrl-char so tmux sees C-M-hjkl
keybind = alt+h=text:\x1b\x08
keybind = alt+j=text:\x1b\x0a
keybind = alt+k=text:\x1b\x0b
keybind = alt+l=text:\x1b\x0c

# Hyper+m / Cmd+m for tmux pane zoom toggle (both translate to M-m)
keybind = f18=text:\x1bm
keybind = super+m=text:\x1bm

# Cmd+s sends vm-1's plain tmux prefix (Ctrl-a), including through local tmux.
keybind = super+s=text:\x01

working-directory = /Users/drew
window-inherit-working-directory = false
